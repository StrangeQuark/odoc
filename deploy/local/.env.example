ODOC_DATABASE_NAME=odoc
ODOC_DATABASE_USERNAME=odoc
ODOC_DATABASE_PASSWORD=odoc
ODOC_POSTGRES_PORT=5432
# Bounded API/worker PostgreSQL pool and session policy. Values are Spring durations.
ODOC_DATABASE_MAX_POOL_SIZE=10
ODOC_DATABASE_MIN_IDLE=2
ODOC_DATABASE_CONNECTION_TIMEOUT=5s
ODOC_DATABASE_VALIDATION_TIMEOUT=3s
ODOC_DATABASE_MAX_LIFETIME=25m
ODOC_DATABASE_STATEMENT_TIMEOUT=15s
ODOC_DATABASE_LOCK_TIMEOUT=5s
ODOC_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=30s
ODOC_MANAGED_ENCRYPTION_ENABLED=true
# Public development-only test key; never use in a deployed environment.
ODOC_MANAGED_ENCRYPTION_WRAPPING_KEY_BASE64=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA
ODOC_AUTH_LOCAL_REGISTRATION_ENABLED=true
ODOC_AUTH_SECURE_COOKIES=false
ODOC_MINIO_ROOT_USER=odoc-minio
ODOC_MINIO_ROOT_PASSWORD=odoc-minio-local-only
ODOC_MEDIA_BUCKET=odoc-media
ODOC_MINIO_PORT=9000
ODOC_MINIO_CONSOLE_PORT=9001
ODOC_MAILPIT_SMTP_PORT=1025
ODOC_MAILPIT_UI_PORT=8025
