{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Odoc zero-knowledge capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "release",
    "generation",
    "issuedAt",
    "expiresAt",
    "protocol",
    "editorSchemaVersion",
    "enabledCapabilities",
    "evidence",
    "signingKeyId",
    "signature"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "release": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "envelopeFormatVersion"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "envelopeFormatVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "editorSchemaVersion": { "type": "integer", "minimum": 1 },
    "enabledCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "content-editing",
          "comments",
          "history",
          "media",
          "collaboration",
          "public-sharing",
          "local-search",
          "encrypted-export"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "uri"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "uri": { "type": "string", "format": "uri-reference" }
        }
      }
    },
    "revoked": { "type": "boolean", "default": false },
    "signingKeyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
